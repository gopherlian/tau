#!/usr/bin/env bash

set -euo pipefail

help_info() {
  echo "
Usage: ${0##*/} [options]
Build a Tau release package for Linux from a release branch whose HEAD has an
annotated tau-vMAJOR.MINOR.PATCH tag.

Wraps script/bundle-linux, compiles the tag's version into the app as TAU_VERSION,
and builds Tau's remote server with script/tau-build-remote-server, which needs
Docker. Writes these release assets to target/release, each with a .sha256 file:
  tau-<version>-linux-<arch>.tar.gz   the package, with the remote server for
                                      <arch> in zed.app/libexec
  tau-remote-server-linux-<arch>.gz   the remote server
See docs/tau/versioning.md.

Options:
  -h, --help    Display this help and exit.
  "
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

cd "$(dirname "$0")/.."

channel=$(<crates/zed/RELEASE_CHANNEL)
if [[ "$channel" != "stable" ]]; then
    echo "crates/zed/RELEASE_CHANNEL is '$channel', but release packages are built from a release branch where it is 'stable'." >&2
    exit 1
fi

# Untracked files count too: the assets crate embeds whole folders, so a stray
# file would ship in the package.
if [[ -n "$(git status --porcelain)" ]]; then
    echo "The working tree has uncommitted changes or untracked files; release packages are built from a clean tag:" >&2
    git status --short >&2
    exit 1
fi

# Tau's tags start with tau-v because Zed's own v-prefixed tags would collide
# with Tau's versions. Lightweight tags are ignored: a release tag is annotated.
tag_refs=$(git for-each-ref --points-at HEAD --format='%(objecttype) %(refname:short)' 'refs/tags/tau-v*')
release_tags=()
while read -r object_type name; do
    if [[ "$object_type" == "tag" ]]; then
        release_tags+=("$name")
    fi
done <<< "$tag_refs"
if [[ ${#release_tags[@]} -eq 0 ]]; then
    echo "HEAD has no annotated tau-v tag; tag the release first, for example: git tag -a tau-v0.1.0 -m \"Tau 0.1.0\"" >&2
    exit 1
fi
if [[ ${#release_tags[@]} -gt 1 ]]; then
    echo "HEAD has several release tags (${release_tags[*]}); keep only the one being released." >&2
    exit 1
fi
tag="${release_tags[0]}"

numeric='(0|[1-9][0-9]*)'
pre_release_identifier='(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)'
semantic_version="^${numeric}\.${numeric}\.${numeric}(-${pre_release_identifier}(\.${pre_release_identifier})*)?$"
version="${tag#tau-v}"
if [[ ! "$version" =~ $semantic_version ]]; then
    echo "Tag '$tag' is not a tau-vMAJOR.MINOR.PATCH semantic version tag." >&2
    exit 1
fi
export TAU_VERSION="$version"

# Zed's update server would replace Tau with Zed, so automatic updates are turned
# off at compile time, the same way Linux distributions package Zed.
export ZED_UPDATE_EXPLANATION="Tau does not update itself yet. Download new versions from https://github.com/gopherlian/tau/releases"
# script/bundle-linux also builds a remote server, linked against musl unless told
# otherwise, which needs musl-gcc. Tau ships the one from
# script/tau-build-remote-server instead, so a glibc build is enough here.
if [[ -z "${REMOTE_SERVER_TARGET:-}" ]]; then
    REMOTE_SERVER_TARGET=$(rustc -vV | sed -n 's/^host: //p')
    if [[ -z "$REMOTE_SERVER_TARGET" ]]; then
        echo "rustc -vV did not report a host target." >&2
        exit 1
    fi
fi
export REMOTE_SERVER_TARGET

# The remote server builds first: it needs Docker, and failing then is cheaper
# than after the editor build.
script/tau-build-remote-server
script/bundle-linux --skip-sentry

target_dir="${CARGO_TARGET_DIR:-target}"
arch=$(uname -m)
archive="tau-${version}-linux-${arch}.tar.gz"
bundle="${target_dir}/release/zed-linux-${arch}.tar.gz"
if [[ ! -f "$bundle" ]]; then
    echo "script/bundle-linux did not produce ${bundle}." >&2
    exit 1
fi
# script/tau-build-remote-server always writes here, whatever CARGO_TARGET_DIR is,
# because its cargo target directory lives inside the container.
server_dir="target/tau-remote-server"
server_asset="tau-remote-server-linux-${arch}.gz"
if [[ ! -f "${server_dir}/${server_asset}" ]]; then
    echo "script/tau-build-remote-server did not produce ${server_dir}/${server_asset}." >&2
    exit 1
fi

# The package carries the remote server for its own architecture, where the
# editor looks for it next to zed-editor, so remote development to hosts of that
# architecture needs no download. The server is appended to the finished archive
# so that script/bundle-linux, which comes from Zed, stays unchanged. The staging
# directory is under the target directory because /tmp may be too small for the
# uncompressed package.
staging_dir=$(mktemp -d -p "$target_dir")
trap 'rm -rf "$staging_dir"' EXIT
mkdir -p "${staging_dir}/zed.app/libexec"
cp "${server_dir}/${server_asset}" "${staging_dir}/zed.app/libexec/"
gzip --decompress --stdout "$bundle" > "${staging_dir}/package.tar"
tar --append --file "${staging_dir}/package.tar" -C "$staging_dir" "zed.app/libexec/${server_asset}"
gzip --stdout "${staging_dir}/package.tar" > "${target_dir}/release/${archive}"
rm "$bundle"
(cd "${target_dir}/release" && sha256sum "${archive}" > "${archive}.sha256")
cp "${server_dir}/${server_asset}" "${server_dir}/${server_asset}.sha256" "${target_dir}/release/"

echo "Built the release assets in ${target_dir}/release, each with a .sha256 file:"
echo "  ${archive}"
echo "  ${server_asset}"
